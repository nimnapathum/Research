# Copy to .env for local development. Never commit real credentials.
DATABASE_URL=postgres://localhost:5432/security_trust_portal
API_PORT=4000
API_HOST=127.0.0.1
API_INTERNAL_URL=http://127.0.0.1:4000
NEXT_PUBLIC_PORTAL_URL=http://127.0.0.1:3000
SESSION_DAYS=7
# Local recorded-task bridge (restart-local.sh sets these for this Mac).
# Enable only when the checkpoint service runs with the same STUDY_DATA_DIR.
CHECKPOINT_BRIDGE_ENABLED=0
# STUDY_MATERIALS_ROOT=/absolute/path/to/Research/study-system
STUDY_PUBLIC_URL=http://127.0.0.1:4175
# STUDY_DATA_DIR=/approved/restricted/checkpoint-data
