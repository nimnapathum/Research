# Copy to .env for local development. Never commit real credentials.
DATABASE_URL=postgres://localhost:5432/security_trust_portal
API_PORT=4000
API_HOST=127.0.0.1
API_INTERNAL_URL=http://127.0.0.1:4000
NEXT_PUBLIC_PORTAL_URL=http://127.0.0.1:3000
SESSION_DAYS=7
# Current workflow. Both API and web must use the same value.
STUDY_PROTOCOL=natural
# Paths below are relative to apps/api and apps/web when using workspace npm scripts.
STUDY_EVIDENCE_ROOT=../../.local-evidence
STUDY_PACKAGE_ROOT=../../.local-packages
# The allocation bridge still needs the local study service on port 4175.
CHECKPOINT_BRIDGE_ENABLED=1
# STUDY_MATERIALS_ROOT=/absolute/path/to/Research/study-system
STUDY_PUBLIC_URL=http://127.0.0.1:4175
# STUDY_DATA_DIR=/approved/restricted/checkpoint-data
